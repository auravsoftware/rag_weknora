# config/builtin_models.yaml.example — Mẫu cấu hình Model Offline mặc định cho 1x GPU 24GB VRAM.
#
# Sao chép thành config/builtin_models.yaml (hoặc trỏ BUILTIN_MODELS_CONFIG tới đường dẫn tùy chỉnh)
# để tự động đăng ký các model mặc định khi khởi động hệ thống.

builtin_models:
  - id: builtin-qwen25-vl-llm
    name: Qwen/Qwen2.5-VL-7B-Instruct-AWQ
    type: KnowledgeQA
    source: remote
    is_default: true
    description: "Qwen2.5-VL-7B-Instruct (Offline LLM Hỏi đáp RAG & Tóm tắt tài liệu - dùng chung vLLM với OCR)"
    parameters:
      base_url: http://vllm-qwen25-vl:7670/v1
      api_key: local-offline-key
      provider: generic
      interface_type: openai
      supports_vision: true
      context_window: 16384
      max_output_tokens: 4096

  - id: builtin-qwen25-vl-ocr
    name: Qwen/Qwen2.5-VL-7B-Instruct-AWQ
    type: VLLM
    source: remote
    is_default: true
    description: "Qwen2.5-VL-7B-Instruct (Offline VLM OCR nhận diện PDF Scan, bảng biểu, con dấu - dùng chung vLLM với LLM)"
    parameters:
      base_url: http://vllm-qwen25-vl:7670/v1
      api_key: local-offline-key
      provider: generic
      interface_type: openai
      supports_vision: true
      context_window: 16384
      max_output_tokens: 4096

  - id: builtin-bge-m3-embedding
    name: BAAI/bge-m3
    type: Embedding
    source: remote
    is_default: true
    description: "BAAI/bge-m3 (Offline Multilingual Embedding 1024 chiều tối ưu tiếng Việt)"
    parameters:
      base_url: http://infinity-models:7671/v1
      api_key: local-offline-key
      provider: generic
      embedding_parameters:
        dimension: 1024
        truncate_prompt_tokens: 0

  - id: builtin-bge-reranker-v2-m3
    name: BAAI/bge-reranker-v2-m3
    type: Rerank
    source: remote
    is_default: true
    description: "BAAI/bge-reranker-v2-m3 (Offline Cross-Encoder Reranker chấm điểm lại ngữ cảnh tiếng Việt)"
    parameters:
      base_url: http://infinity-models:7671/v1
      api_key: local-offline-key
      provider: generic
