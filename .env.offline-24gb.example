# =====================================================================
# Cấu hình Môi trường (.env) cho Hệ thống RAG Tiếng Việt 100% Offline
# Phần cứng mục tiêu: 1x NVIDIA RTX PRO 4000 Blackwell (24GB VRAM)
# Hướng dẫn: cp .env.offline-24gb.example .env
# =====================================================================

# 1. Ngôn ngữ & Múi giờ mặc định (Tiếng Việt)
DEFAULT_LOCALE=vi-VN
VITE_DEFAULT_LOCALE=vi-VN
WEKNORA_LANGUAGE=vi-VN
TZ=Asia/Ho_Chi_Minh
GIN_MODE=release
LOG_LEVEL=info

# 2. Cổng giao tiếp dịch vụ (Dải cổng 6666 - 6672 để tránh xung đột với các dịch vụ khác trên máy chủ)
FRONTEND_PORT=6666
APP_PORT=6667
DB_PORT=6668
REDIS_PORT=6669
VLLM_PORT=6670
INFINITY_PORT=6671
DOCREADER_PORT=6672
MAX_FILE_SIZE_MB=100

# 3. Cơ sở dữ liệu PostgreSQL (ParadeDB: pgvector HNSW + pg_search BM25)
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora
RETRIEVE_DRIVER=postgres
AUTO_MIGRATE=true

# 4. Hàng đợi tác vụ bất đồng bộ Redis
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis123!@#

# 5. Lưu trữ tệp cục bộ
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files

# 6. Khóa bảo mật (Hãy thay bằng chuỗi ngẫu nhiên 32 byte khi chạy Production)
# Tạo bằng lệnh: openssl rand -hex 16
SYSTEM_AES_KEY=0123456789abcdef0123456789abcdef
JWT_SECRET=vi-rag-offline-jwt-secret-key-change-in-production

# 7. Cấu hình cụm Model Offline trên 1x GPU 24GB VRAM
# Thư mục lưu cache model trên máy chủ (để chạy offline không cần tải lại)
HF_CACHE_DIR=./models_cache/huggingface
# Đặt HF_HUB_OFFLINE=1 sau khi đã tải sẵn model về HF_CACHE_DIR để ngắt kết nối Internet hoàn toàn
HF_HUB_OFFLINE=0

# 7.1. Unified LLM (Hỏi đáp RAG) + VLM (OCR PDF Scan): Qwen2.5-VL-7B-Instruct-AWQ
VLLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
VLLM_GPU_MEMORY_UTILIZATION=0.62
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=8
VLM_HTTP_TIMEOUT_SECONDS=300
VLM_MAX_TOKENS=4096

# 7.2. Embedding & Reranker (Chạy chung trên Infinity Server)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
